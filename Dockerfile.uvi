# Start from the Python 3.10 slim image
FROM python:3.10-slim

# Set the working directory inside the container
WORKDIR /app

# Copy only the necessary files for the app to work
COPY glconnect/voc.py /app/glconnect/voc.py           
COPY glconnect/models.py /app/glconnect/models.py   
COPY requirements.txt /app/requirements.txt            
RUN pip install uvicorn
# Install dependencies
#RUN pip install -r requirements.txt

# Expose the port that the FastAPI app will run on
EXPOSE 8001

CMD ["uvicorn", "glconnect.voc:app", "--host", "0.0.0.0", "--port", "8002"]


