FROM phasecorex/liquidsoap:latest

# Create the directory inside the image
RUN mkdir -p /liqfolder/scripts

# Copy your Liquidsoap scripts from host into the image
COPY scripts/ /liqfolder/scripts/
# Debug: List the contents of the directory at build time
RUN echo "📂 Contents of /liqfolder/scripts:" && ls -la /liqfolder/scripts

# Final command to run your Liquidsoap script
CMD ["liquidsoap", "/liqfolder/scripts/main.liq"]

