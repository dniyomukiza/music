# Copy to .env and fill with your values. Do not commit .env.

# App
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_URL=postgresql://user:password@host:5432/dbname

# Auth & security
RECAPTCHAPUB=your-recaptcha-site-key
RECAPTCHAPRIV=your-recaptcha-secret-key

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_BASE_URL=https://glc.cool/
# Stripe Connect: authors need stripe_connect_account_id for marketplace checkout (destination charge + application fee).
# Set to 1 only for local/dev when authors have no Connect account (charge stays on platform; splits in DB still assume 70/30).
STRIPE_CONNECT_ALLOW_PLATFORM_ONLY=0
# Country for new Express accounts (ISO 3166-1 alpha-2). Use the platform’s primary market or collect per author later.
STRIPE_CONNECT_DEFAULT_COUNTRY=US
https://connect.stripe.com/d/setup/e/_UKdWZ5zmo4wl2T98cGkJ9z5epu/YWNjdF8xVEx5RllKREpaRzhqQWFi/a16504c821fbc362d
# AI
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: Gemini model ID for AI book covers / picture-game images (image-capable). If unset, the app tries a short fallback list.
# BOOK_COVER_AI_MODEL=gemini-2.0-flash-preview-image-generation
GEMINI_MAX_TOKENS=1000
GEMINI_TEMPERATURE=0.7
OPENAI_AI_KEY=
OPENAI_API_KEY=

# Google Cloud (TTS, etc.)
GOOGLE_APPLICATION_CREDENTIALS=tts.json

# Email (e.g. Mailtrap)
SENDER_MAIL=info@example.com
SENDER_PASSWORD=
RECEIVER_MAIL=info@example.com
MAIL_TRAP=your-mailtrap-api-key

# YouTube / music pipeline
YTDLP_COOKIES_FILE=/path/to/ytdlp_cookies.txt

# Optional
ICECAST_CONFIG=


As UI/UX designer with 10 years of experience in a FAANG company, revamp this page considerably to increase user experience so we can stay competitive with the leaders in the market

