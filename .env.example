# Copy to .env and fill with your values. Do not commit .env.

# App
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here
# Data lifecycle: testing permits destructive cleanup of synthetic records;
# set to live before launch to preserve financial and entitlement history.
DATA_LIFECYCLE_MODE=testing

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_URL=postgresql://user:password@host:5432/dbname

# Auth & security
RECAPTCHAPUB=your-recaptcha-site-key
RECAPTCHAPRIV=your-recaptcha-secret-key

# Payments (Stripe)
# Server API uses STRIPE_SECRET_KEY (required for checkout). STRIPE_API_KEY is an optional second
# name for the *same secret* key (sk_test_... / sk_live_...). Do NOT put the publishable key (pk_...)
# in STRIPE_API_KEY — only "Secret key" from https://dashboard.stripe.com/apikeys works.
# If STRIPE_SECRET_KEY is set, you can omit STRIPE_API_KEY entirely.
# Optional aliases the server also accepts: STRIPE_KEY, STRIPE_PRIVATE_KEY (same sk_... value as in Stripe Dashboard).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# If your Stripe secret key has IP restrictions (recommended for production), the allowlist must
# include this host's *outbound* egress IP — not your public site URL. After deploy, open
# /mybook/admin/stripe-diagnostics (admin) to read outbound_ip, or check startup logs:
# "Stripe: server outbound IP (add to key allowlist if restricted): x.x.x.x"
# Set STRIPE_LOG_OUTBOUND_IP=0 to disable startup IP/probe logging.
# Production host + Stripe test mode: in /etc/glconfig.json set a test secret using the same naming pattern
# as live keys: STRIPE_TEST_SECRET or STRIPE_TEST_KEY or STRIPE_TEST_PRIVATE_KEY (sk_test_...),
# optionally STRIPE_TEST_API or STRIPE_TEST_API_KEY, and STRIPE_TEST_WEBHOOK_SECRET or STRIPE_TEST_WEBHOOK (test whsec_...).
# When a test secret is present, it overrides STRIPE_SECRET_KEY / STRIPE_API_KEY from env.
# If that value is invalid (not sk_...), startup fails — it will not fall back to live keys.
# Use STRIPE_TEST_WEBHOOK_SECRET for webhooks in this mode. Remove test keys from glconfig for live Stripe.
FRONTEND_BASE_URL=https://ndotonic.com/
# Allowed browser origins for CORS + SocketIO (comma-separated). Defaults in code cover
# ndotonic.com (and legacy glc.cool during migration). Override per environment, e.g. for staging:
# ALLOWED_ORIGINS=https://staging.ndotonic.com,http://localhost:5000
ALLOWED_ORIGINS=https://ndotonic.com,https://www.ndotonic.com,https://glc.cool,https://www.glc.cool
# Book campaigns: 1 (default) = patronage — funders support projects; no sale revenue share to funders.
# Set to 0 only to restore legacy investment returns from marketplace sales.
BOOK_CAMPAIGN_PATRONAGE=1
# Stripe Connect: authors need stripe_connect_account_id for marketplace checkout (destination charge + application fee).
# Set to 1 only for local FLASK_ENV=development when authors have no Connect account.
# Ignored in production (always fail-closed: paid checkout requires ready Connect).
STRIPE_CONNECT_ALLOW_PLATFORM_ONLY=0
# Country for new Express accounts (ISO 3166-1 alpha-2). Use the platform’s primary market or collect per author later.
STRIPE_CONNECT_DEFAULT_COUNTRY=US
# Stripe Tax: set to 1 after enabling Tax in the Stripe Dashboard (and registering where required).
# When on, Checkout collects billing address and calculates tax; when off, no tax is collected.
STRIPE_TAX_ENABLED=0
# AI
GOOGLE_API_KEY=
# For AI Studio / Gemini image (covers, picture game): if both GOOGLE_API_KEY and GEMINI_API_KEY are set, image generation uses GEMINI_API_KEY first.
GEMINI_API_KEY=
# Optional: HeyGen complementary news video bulletin (after audio succeeds).
# Production: set HEYGEN_API_KEY in /etc/glconfig.json rather than baking it into the image.
HEYGEN_API_KEY=
# Optional: Parallel Search API for live news facts before Gemini writes scripts.
# If unset, audio news still generates from Gemini knowledge (previous behavior).
# Production: set PARALLEL_API_KEY in /etc/glconfig.json.
PARALLEL_API_KEY=
# PARALLEL_SEARCH_MODE=turbo
# Required for signed Monitor notifications; copy from Parallel Settings → Webhooks.
PARALLEL_WEBHOOK_SECRET=
# Optional explicit public URL. Defaults to:
# https://ndotonic.com/routes2/news/api/parallel-monitors/webhook
# PARALLEL_WEBHOOK_URL=https://ndotonic.com/routes2/news/api/parallel-monitors/webhook
# Guard against creating monitors for unlimited one-off topics. Default: 20.
# PARALLEL_MONITOR_MAX_ACTIVE=20
# Optional: Gemini model for news scripts and topic validation. Default: gemini-3.6-flash
# NEWS_GEMINI_MODEL=gemini-3.6-flash
# NEWS_TOPIC_GEMINI_MODEL=gemini-3.6-flash
# Book covers use Gemini 3.1 Flash Image (see glconnect/book_cover_ai.py), then Imagen if needed. Optional Imagen override:
# Optional: Imagen model when Gemini image is exhausted (separate quota). Default is imagen-4.0-fast-generate-001.
# BOOK_COVER_IMAGEN_MODEL=imagen-4.0-fast-generate-001
GEMINI_MAX_TOKENS=1000
GEMINI_TEMPERATURE=0.7
OPENAI_AI_KEY=
OPENAI_API_KEY=

# Google Cloud (TTS, etc.)
GOOGLE_APPLICATION_CREDENTIALS=tts.json
# Alternative for Render/production: paste the full service-account JSON on one line
# GOOGLE_TTS_CREDENTIALS_JSON={"type":"service_account",...}

# Email (Resend) — also supported in /etc/glconfig.json as SENDER_MAIL + RESEND_API_KEY
# Replace re_xxxxxxxxx with your real API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# From address must be a domain you verified at https://resend.com/domains
# (or use onboarding@resend.dev for Resend's test sender).
SENDER_MAIL=info@ndotonic.com
RECEIVER_MAIL=info@ndotonic.com
# Optional override if SENDER_MAIL is not the Resend From address
# RESEND_FROM=Ndotonic <info@ndotonic.com>

# YouTube / music pipeline
YTDLP_COOKIES_FILE=/path/to/ytdlp_cookies.txt

# Ink Studio self-publishing (ISBN pool + marketplace imprint)
INK_STUDIO_PUBLISHER_NAME=Ndotonic
ISBN_POOL_SEED_COUNT=100

# Optional
ICECAST_CONFIG

# Ink Studio Milestone 1 — marketplace entry, book campaigns + book sales only.
# Set to 1 on production to hide music/content hub nav and route readers to /mybook/marketplace.
INK_STUDIO_V1_BOOKS_LAUNCH=0
# Render/production: mount persistent disk for static/digital_books, covers, and audiobooks
# (ephemeral filesystem loses uploads on redeploy without a volume).
