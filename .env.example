# Copy to .env and fill with your values. Do not commit .env.

# App
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_URL=postgresql://user:password@host:5432/dbname

# Auth & security
RECAPTCHAPUB=your-recaptcha-site-key
RECAPTCHAPRIV=your-recaptcha-secret-key

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_BASE_URL=https://your-domain.com

# AI
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=1000
GEMINI_TEMPERATURE=0.7
OPENAI_AI_KEY=
OPENAI_API_KEY=

# Google Cloud (TTS, etc.)
GOOGLE_APPLICATION_CREDENTIALS=tts.json

# Email (e.g. Mailtrap)
SENDER_MAIL=info@example.com
SENDER_PASSWORD=
RECEIVER_MAIL=info@example.com
MAIL_TRAP=your-mailtrap-api-key

# YouTube / music pipeline
YTDLP_COOKIES_FILE=/path/to/ytdlp_cookies.txt

# Optional
ICECAST_CONFIG=
