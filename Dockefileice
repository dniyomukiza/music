# Use the official Deepcomp Icecast2 image as the base
FROM deepcomp/icecast2:latest

# Copy your local icecast.xml configuration into the container

RUN rm -f /etc/icecast.xml.sample
# Debugging commands to check if the file was copied correctly
RUN ls -l /etc
COPY icecast.xml /etc/icecast.xml
RUN cat /etc/icecast.xml

# Start Icecast with the custom configuration file
CMD ["/bin/sh", "-c", "cat /etc/icecast.xml && icecast -c /etc/icecast.xml"]

